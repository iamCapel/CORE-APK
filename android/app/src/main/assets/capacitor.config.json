{
	"appId": "com.mopc.core",
	"appName": "MOPC Core",
	"webDir": "build",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1000,
			"backgroundColor": "#FF7A00",
			"showSpinner": false,
			"splashFullScreen": true,
			"splashImmersive": true
		},
		"Camera": {
			"permissions": [
				"camera",
				"photos"
			],
			"resultType": "base64",
			"quality": 80,
			"saveToGallery": false
		},
		"Geolocation": {
			"permissions": [
				"location",
				"coarseLocation"
			],
			"enableHighAccuracy": true,
			"timeout": 10000
		},
		"App": {
			"appendUserAgent": "MOPC-Core/1.0"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
